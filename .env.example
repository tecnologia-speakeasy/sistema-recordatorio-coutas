# Copiar a .env.local (desarrollo) o configurar en el hosting. Nunca commitear valores reales.

# --- Base de datos -----------------------------------------------------------
# Misma BD donde están las cuotas; el sistema escribe solo en el esquema `recordatorios`.
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos?sslmode=require

# --- General -----------------------------------------------------------------
# URL pública de esta app (se usa para mostrar el link del botón en el dashboard).
APP_URL=https://recordatorios.tudominio.com
APP_TIMEZONE=America/Bogota
TELEFONO_CODIGO_PAIS=57
MONEDA=COP
# Ventana [inicio, fin) en la que el cron puede despachar mensajes.
HORA_INICIO_ENVIO=8
HORA_FIN_ENVIO=20
# Tiempo máximo de despacho por ejecución (menor que maxDuration=300 del endpoint).
PRESUPUESTO_EJECUCION_SEG=240
# Separación mínima entre dos recordatorios al mismo teléfono.
ESPERA_MISMO_CONTACTO_SEG=60

# --- Seguridad ---------------------------------------------------------------
# openssl rand -hex 32
CRON_SECRET=
DASHBOARD_USUARIO=admin
DASHBOARD_CLAVE=
# Opcional: habilita /api/webhooks/ghl (confirmación desde el workflow).
GHL_WEBHOOK_SECRET=

# --- HighLevel (GHL) ---------------------------------------------------------
# Private Integration Token de la subcuenta (Settings > Private Integrations).
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_API_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=v3
# true = no llama a GHL; marca los envíos como enviados (para probar con datos reales).
GHL_DRY_RUN=true

# --- Google Sheets (opcional) -------------------------------------------------
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_PESTANA=Envios
GOOGLE_SA_EMAIL=
# Llave privada de la cuenta de servicio en una sola línea, con \n escapados.
GOOGLE_SA_PRIVATE_KEY=
