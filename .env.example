# Copiar a .env.local (desarrollo) o configurar en el hosting. Nunca commitear valores reales.

# --- Base de datos -----------------------------------------------------------
# La misma BD de inventario-speakeasy: lee public.cartera_* y escribe solo en el esquema `recordatorios`.
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos?sslmode=require

# --- General -----------------------------------------------------------------
# URL pública de esta app. El estudiante recibe APP_URL/p/<token>, que redirige a su link de pago.
APP_URL=https://recordatorios.speakeasyacademia.com
APP_TIMEZONE=America/Bogota
# Solo si el país de la compra no se reconoce y el número no trae indicativo.
TELEFONO_CODIGO_PAIS=57
# Ventana [inicio, fin) en la que el cron puede despachar mensajes.
HORA_INICIO_ENVIO=8
HORA_FIN_ENVIO=20
# Tiempo máximo de despacho por ejecución (menor que maxDuration=300 del endpoint).
PRESUPUESTO_EJECUCION_SEG=240
# Separación mínima entre dos mensajes al mismo teléfono.
ESPERA_MISMO_CONTACTO_SEG=60
# Horas entre el primer clic en "Pagar ahora" y el mensaje "¿pudiste pagar?".
SEGUIMIENTO_HORAS=3

# --- Seguridad ---------------------------------------------------------------
# openssl rand -hex 32
CRON_SECRET=
DASHBOARD_USUARIO=admin
DASHBOARD_CLAVE=
# Habilita /api/webhooks/ghl, donde los workflows informan "Pago realizado" / "Soporte".
GHL_WEBHOOK_SECRET=

# --- HighLevel (GHL) ---------------------------------------------------------
# El envío NO usa token: cada etapa dispara su workflow por la URL de su webhook
# entrante (se pega en el dashboard). El token es solo de LECTURA, para verificar
# si el WhatsApp se entregó/leyó/falló. Sin token, los envíos se quedan en "enviado".
# Private Integration Token de la subcuenta (Settings > Private Integrations), solo con:
# View Contacts (contacts.readonly), View Conversations (conversations.readonly),
# View Conversation Messages (conversations/message.readonly)
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_API_URL=https://services.leadconnectorhq.com
# true = no llama a GHL; marca los envíos como enviados (para probar con datos reales).
GHL_DRY_RUN=true

# --- Google Sheets vía n8n (opcional) ----------------------------------------
# URL de producción del webhook del workflow integraciones/n8n-google-sheets.json.
# Pestañas "Cuota 2", "Cuota 3"... con una fila por estudiante y cuota. Vacío = no sincroniza.
SHEETS_WEBHOOK_URL=
